[Unit]
Description=Trama web application
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/disks/trama-data

[Service]
Type=simple
User=trama
Group=trama
WorkingDirectory=/opt/trama/current
EnvironmentFile=/etc/trama/trama.env
ExecStart=/opt/trama/current/api
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/mnt/disks/trama-data

[Install]
WantedBy=multi-user.target

